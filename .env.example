# Conexión que usa la aplicación. Con Neon, la cadena del pooler.
DATABASE_URL="postgresql://mineops:mineops@localhost:5432/mineops"

# Conexión directa para las migraciones; la lee prisma.config.ts. Con Neon, la cadena
# sin "-pooler": las migraciones abren transacciones que PgBouncer no soporta.
MIGRATE_DATABASE_URL="postgresql://mineops:mineops@localhost:5432/mineops"

# openssl rand -base64 32
AUTH_SECRET=""

# URL pública de la aplicación, con esquema.
AUTH_URL="http://localhost:3000"
