# Connection used by the application. On Neon, the pooler string.
DATABASE_URL="postgresql://mineops:mineops@localhost:5432/mineops"

# Direct connection for migrations, read by prisma.config.ts. On Neon, the string without
# "-pooler": PgBouncer in transaction mode cannot run them.
MIGRATE_DATABASE_URL="postgresql://mineops:mineops@localhost:5432/mineops"

# openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the application, including the scheme.
AUTH_URL="http://localhost:3000"
